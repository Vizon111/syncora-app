# Supabase project connection
# Get these from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public, safe to expose to the browser. Used by lib/supabase/client.ts
# (browser auth) and lib/supabase/server.ts (SSR session resolution) — RLS
# policies in supabase/migrations/ apply to requests made with this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY. Bypasses RLS — never expose to the client, never prefix with NEXT_PUBLIC_.
# Used by lib/db/storage.ts. Authorization for app data is enforced in
# application code via lib/db/rbac.ts and db.authorize()/requireWorkspaceMember()
# rather than relying solely on RLS + auth.uid() — see lib/db/supabase-client.ts
# for the full rationale. Real user identity now comes from a verified
# Supabase Auth session (see lib/supabase/server.ts's getAuthenticatedUser()),
# not this key — this key is about database access, not who's making the request.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string (used only for running migrations, e.g. via
# `psql -f supabase/migrations/0001_core.sql "$DATABASE_URL"` or the Supabase CLI).
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Google sign-in (components/auth/google-auth-button.tsx) requires no extra
# env vars here — it's configured entirely in the Supabase Dashboard:
#   1. Authentication > Sign In / Up > Google: enable it and paste the
#      Client ID / Secret from a Google Cloud OAuth 2.0 Client (Web application).
#   2. In Google Cloud Console, add this as an Authorized redirect URI:
#      https://<your-project-ref>.supabase.co/auth/v1/callback
#   3. In Authentication > URL Configuration, make sure your app's origin
#      (e.g. http://localhost:3000, or your production URL) is in the
#      Redirect URLs allow list — app/auth/callback/route.ts is what
#      completes the sign-in after Google redirects back.

# File uploads (components/views/files-view.tsx) require no extra env vars
# here either — they use the same Supabase project, but need a Storage
# bucket created manually first (buckets can't be created via SQL):
#   1. Supabase Dashboard > Storage > New bucket, name it "project-files"
#   2. Leave it PRIVATE (not public) — downloads go through a signed URL
#      from app/api/files/download-url, which checks workspace membership.
#   3. Run supabase/migrations/0007_file_storage_bucket.sql in the SQL
#      Editor to grant authenticated users upload/read/delete on it.
