# Supabase project connection
# Get these from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public, safe to expose to the browser. Used by lib/supabase/client.ts
# (browser auth) and lib/supabase/server.ts (SSR session resolution) — RLS
# policies in supabase/migrations/ apply to requests made with this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY. Bypasses RLS — never expose to the client, never prefix with NEXT_PUBLIC_.
# Used by lib/db/storage.ts. Authorization for app data is enforced in
# application code via lib/db/rbac.ts and db.authorize()/requireWorkspaceMember()
# rather than relying solely on RLS + auth.uid() — see lib/db/supabase-client.ts
# for the full rationale. Real user identity now comes from a verified
# Supabase Auth session (see lib/supabase/server.ts's getAuthenticatedUser()),
# not this key — this key is about database access, not who's making the request.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string (used only for running migrations, e.g. via
# `psql -f supabase/migrations/0001_core.sql "$DATABASE_URL"` or the Supabase CLI).
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
