  /**
   * Chunks all documents & files in workspace into search tokens
   */
  public indexWorkspaceDocuments(workspaceId: string) {
    const chunks: DocumentChunk[] = [];
    const docs = Array.from(this.documents.values()).filter((d) => d.workspaceId === workspaceId);

    docs.forEach((doc) => {
      // Split into logical sections
      const sections = doc.rawText.split('\n\n').filter((s) => s.trim().length > 20);
      sections.forEach((sec, idx) => {
        chunks.push({
          id: `chk_${doc.id}_${idx}`,
          workspaceId: doc.workspaceId,
          documentId: doc.id,
          documentTitle: doc.title,
          chunkIndex: idx,
          text: sec.trim(),
          tokenCount: Math.ceil(sec.length / 4),
          createdAt: new Date().toISOString(),
        });
      });
    });

    const files = Array.from(this.files.values()).filter((f) => f.workspaceId === workspaceId && f.extractedText);
    files.forEach((file) => {
      chunks.push({
        id: `chk_file_${file.id}`,
        workspaceId: file.workspaceId,
        documentId: file.id,
        documentTitle: `File: ${file.name}`,
        chunkIndex: 0,
        text: file.extractedText || '',
        tokenCount: Math.ceil((file.extractedText || '').length / 4),
        createdAt: new Date().toISOString(),
      });
    });

    this.documentChunks.set(workspaceId, chunks);
  }

  // --- Multi-Tenant Access & Authorization ---

  public getWorkspaceUser(workspaceId: string, userId: string): WorkspaceMember | null {
    const member = this.workspaceMembers.get(`${workspaceId}_${userId}`);
    return member || null;
  }

  public authorize(workspaceId: string, userId: string, requiredPermission: Permission): { authorized: boolean; member?: WorkspaceMember; error?: string } {
    const member = this.getWorkspaceUser(workspaceId, userId);
    if (!member) {
      return { authorized: false, error: 'User is not a member of this workspace (Tenant Isolation Enforced).' };
    }
    if (!hasPermission(member.role, requiredPermission)) {
      return { authorized: false, member, error: `Role '${member.role}' lacks permission '${requiredPermission}'.` };
    }
    return { authorized: true, member };
  }

  // --- Task Methods ---

  public getTasks(workspaceId: string, projectId?: string): Task[] {
    return Array.from(this.tasks.values()).filter(
      (t) => t.workspaceId === workspaceId && (!projectId || t.projectId === projectId)
    );
  }

  public getTaskById(taskId: string, workspaceId: string): Task | null {
    const t = this.tasks.get(taskId);
    if (!t || t.workspaceId !== workspaceId) return null;
    return t;
  }

  public createTask(task: Task, actor: User): Task {
    this.tasks.set(task.id, task);
    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId: task.workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'created_task',
      targetType: 'task',
      targetId: task.id,
      targetName: task.title,
      details: `Created task in column ${task.status.toUpperCase()} (${task.priority} priority)`,
      createdAt: new Date().toISOString(),
    });
    return task;
  }

  public updateTask(task: Task, actor: User): Task {
    const old = this.tasks.get(task.id);
    this.tasks.set(task.id, task);

    let details = 'Updated task details';
    if (old && old.status !== task.status) {
      details = `Moved from ${old.status.toUpperCase()} to ${task.status.toUpperCase()}`;
    }

    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId: task.workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'updated_task_status',
      targetType: 'task',
      targetId: task.id,
      targetName: task.title,
      details,
      createdAt: new Date().toISOString(),
    });
    return task;
  }

  public deleteTask(taskId: string, workspaceId: string, actor: User): boolean {
    const task = this.getTaskById(taskId, workspaceId);
    if (!task) return false;
    this.tasks.delete(taskId);
    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'updated_task_status',
      targetType: 'task',
      targetId: taskId,
      targetName: task.title,
      details: 'Deleted task',
      createdAt: new Date().toISOString(),
    });
    return true;
  }

  // --- Sprint Methods ---

  public getSprints(workspaceId: string, projectId?: string): Sprint[] {
    const sprints = Array.from(this.sprints.values()).filter(
      (s) => s.workspaceId === workspaceId && (!projectId || s.projectId === projectId)
    );

    // Update dynamic story point totals
    return sprints.map((sprint) => {
      const sprintTasks = Array.from(this.tasks.values()).filter(
        (t) => t.workspaceId === workspaceId && t.sprintId === sprint.id
      );
      const totalSP = sprintTasks.reduce((acc, t) => acc + (t.storyPoints || 0), 0);
      const completedSP = sprintTasks
        .filter((t) => t.status === 'done')
        .reduce((acc, t) => acc + (t.storyPoints || 0), 0);

      return {
        ...sprint,
        totalStoryPoints: totalSP || sprint.totalStoryPoints || 0,
        completedStoryPoints: completedSP || (sprint.status === 'completed' ? sprint.completedStoryPoints || totalSP : 0),
      };
    });
  }

  public getSprintById(sprintId: string, workspaceId: string): Sprint | null {
    const sprint = this.sprints.get(sprintId);
    if (!sprint || sprint.workspaceId !== workspaceId) return null;
    return sprint;
  }

  public createSprint(sprint: Sprint, actor: User): Sprint {
    this.sprints.set(sprint.id, sprint);
    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId: sprint.workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'created_task',
      targetType: 'task',
      targetId: sprint.id,
      targetName: sprint.name,
      details: `Created new sprint: "${sprint.name}" with goal: ${sprint.goal}`,
      createdAt: new Date().toISOString(),
    });
    return sprint;
  }

  public updateSprint(sprint: Sprint, actor: User): Sprint {
    this.sprints.set(sprint.id, sprint);
    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId: sprint.workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'updated_task_status',
      targetType: 'task',
      targetId: sprint.id,
      targetName: sprint.name,
      details: `Updated sprint configuration (${sprint.status.toUpperCase()})`,
      createdAt: new Date().toISOString(),
    });
    return sprint;
  }

  public deleteSprint(sprintId: string, workspaceId: string, actor: User): boolean {
    const sprint = this.getSprintById(sprintId, workspaceId);
    if (!sprint) return false;

    // Move associated tasks back to Product Backlog
    this.tasks.forEach((t) => {
      if (t.workspaceId === workspaceId && t.sprintId === sprintId) {
        t.sprintId = null;
        t.updatedAt = new Date().toISOString();
      }
    });

    this.sprints.delete(sprintId);
    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'updated_task_status',
      targetType: 'task',
      targetId: sprintId,
      targetName: sprint.name,
      details: `Deleted sprint and moved tasks to Backlog`,
      createdAt: new Date().toISOString(),
    });
    return true;
  }

  public startSprint(sprintId: string, workspaceId: string, actor: User): Sprint | null {
    const sprint = this.getSprintById(sprintId, workspaceId);
    if (!sprint) return null;

    sprint.status = 'active';
    sprint.updatedAt = new Date().toISOString();
    this.sprints.set(sprintId, sprint);

    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'updated_task_status',
      targetType: 'task',
      targetId: sprintId,
      targetName: sprint.name,
      details: `Started active sprint: ${sprint.name}`,
      createdAt: new Date().toISOString(),
    });
    return sprint;
  }

  public completeSprint(sprintId: string, workspaceId: string, actor: User): Sprint | null {
    const sprint = this.getSprintById(sprintId, workspaceId);
    if (!sprint) return null;

    // Calculate completed points
    const sprintTasks = Array.from(this.tasks.values()).filter(
      (t) => t.workspaceId === workspaceId && t.sprintId === sprintId
    );
    const completedSP = sprintTasks
      .filter((t) => t.status === 'done')
      .reduce((acc, t) => acc + (t.storyPoints || 0), 0);
    const totalSP = sprintTasks.reduce((acc, t) => acc + (t.storyPoints || 0), 0);

    sprint.status = 'completed';
    sprint.completedStoryPoints = completedSP;
    sprint.totalStoryPoints = totalSP;
    sprint.updatedAt = new Date().toISOString();
    this.sprints.set(sprintId, sprint);

    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'updated_task_status',
      targetType: 'task',
      targetId: sprintId,
      targetName: sprint.name,
      details: `Completed sprint with ${completedSP}/${totalSP} Story Points delivered!`,
      createdAt: new Date().toISOString(),
    });
    return sprint;
  }

  // --- Retrospective Methods ---

  public getRetroItems(workspaceId: string, sprintId?: string): RetroItem[] {
    const items = Array.from(this.retroItems.values()).filter(
      (r) => r.workspaceId === workspaceId && (!sprintId || r.sprintId === sprintId)
    );
    return items.sort((a, b) => (b.votes || 0) - (a.votes || 0) || new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
  }

  public getRetroItemById(itemId: string, workspaceId: string): RetroItem | null {
    const item = this.retroItems.get(itemId);
    if (!item || item.workspaceId !== workspaceId) return null;
    return item;
  }

  public createRetroItem(item: RetroItem, actor: User): RetroItem {
    this.retroItems.set(item.id, item);
    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId: item.workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'created_task',
      targetType: 'task',
      targetId: item.id,
      targetName: item.title,
      details: `Added retrospective card: [${item.category.toUpperCase()}] "${item.title}"`,
      createdAt: new Date().toISOString(),
    });
    return item;
  }

  public updateRetroItem(item: RetroItem, actor: User): RetroItem {
    this.retroItems.set(item.id, item);
    return item;
  }

  public voteRetroItem(itemId: string, userId: string, workspaceId: string): RetroItem | null {
    const item = this.getRetroItemById(itemId, workspaceId);
    if (!item) return null;

    const voted = item.votedUserIds || [];
    const hasVoted = voted.includes(userId);

    if (hasVoted) {
      item.votedUserIds = voted.filter((id) => id !== userId);
      item.votes = Math.max(0, (item.votes || 1) - 1);
    } else {
      item.votedUserIds = [...voted, userId];
      item.votes = (item.votes || 0) + 1;
    }

    this.retroItems.set(item.id, item);
    return item;
  }

  public deleteRetroItem(itemId: string, workspaceId: string, actor: User): boolean {
    const item = this.getRetroItemById(itemId, workspaceId);
    if (!item) return false;
    this.retroItems.delete(itemId);
    return true;
  }

  public convertRetroActionToTask(
    itemId: string,
    workspaceId: string,
    targetSprintId: string | null,
    actor: User
  ): { task: Task; retroItem: RetroItem } | null {
    const item = this.getRetroItemById(itemId, workspaceId);
    if (!item) return null;

    const sprint = targetSprintId ? this.getSprintById(targetSprintId, workspaceId) : null;
    const defaultProject = Array.from(this.projects.values()).find((p) => p.workspaceId === workspaceId);
    const projectId = sprint?.projectId || defaultProject?.id || 'prj_flowspace_core';

    const newTask: Task = {
      id: `tsk_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`,
      workspaceId,
      projectId,
      sprintId: targetSprintId,
      title: item.title,
      description: `[Создано из Ретроспективы Спринта]: ${item.description}\n\nАвтор идеи: ${item.authorName} (Голосов: ${item.votes})`,
      status: 'todo',
      priority: item.priority || 'high',
      storyPoints: 3,
      estimatedHours: 8,
      loggedHours: 0,
      worklogs: [],
      assigneeId: item.assigneeId || actor.id,
      assignee: item.assigneeId ? this.users.get(item.assigneeId) || actor : actor,
      reporterId: actor.id,
      reporter: actor,
      dueDate: item.dueDate || new Date(Date.now() + 7 * 86400000).toISOString().split('T')[0],
      labels: ['Retro Action', 'Agile', 'Improvement'],
      commentsCount: 0,
      order: 0,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
    };

    this.tasks.set(newTask.id, newTask);

    item.status = 'converted_to_task';
    item.convertedTaskId = newTask.id;
    this.retroItems.set(item.id, item);

    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'created_task',
      targetType: 'task',
      targetId: newTask.id,
      targetName: newTask.title,
      details: `Converted Retro Action Item into actionable task ${targetSprintId ? `in sprint "${sprint?.name}"` : 'in Product Backlog'}`,
      createdAt: new Date().toISOString(),
    });

    return { task: newTask, retroItem: item };
  }

  public getSprintRetroSummary(workspaceId: string, sprintId: string): SprintRetroSummary | null {
    return this.sprintRetroSummaries.get(`${workspaceId}_${sprintId}`) || null;
  }

  public saveSprintRetroSummary(summary: SprintRetroSummary, actor: User): SprintRetroSummary {
    this.sprintRetroSummaries.set(`${summary.workspaceId}_${summary.sprintId}`, summary);
    return summary;
  }

  // --- Worklog / Time Tracking Methods ---

  public logWorkTime(
    taskId: string,
    workspaceId: string,
    worklog: Omit<WorklogItem, 'id' | 'loggedAt' | 'user'>,
    actor: User
  ): { task: Task; worklog: WorklogItem } | null {
    const task = this.getTaskById(taskId, workspaceId);
    if (!task) return null;

    const newLog: WorklogItem = {
      id: `wl_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`,
      taskId,
      userId: actor.id,
      user: actor,
      hours: Number(worklog.hours),
      description: worklog.description || 'General task development & implementation',
      loggedAt: new Date().toISOString(),
    };

    const currentLogs = task.worklogs || [];
    task.worklogs = [newLog, ...currentLogs];
    task.loggedHours = Number((task.worklogs.reduce((sum, item) => sum + (Number(item.hours) || 0), 0)).toFixed(2));
    task.updatedAt = new Date().toISOString();

    this.tasks.set(task.id, task);

    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'updated_task_status',
      targetType: 'task',
      targetId: task.id,
      targetName: task.title,
      details: `Logged ${newLog.hours}h: "${newLog.description}" (Total: ${task.loggedHours}h / ${task.estimatedHours || 0}h)`,
      createdAt: new Date().toISOString(),
    });

    return { task, worklog: newLog };
  }

  public deleteWorklog(taskId: string, worklogId: string, workspaceId: string, actor: User): Task | null {
    const task = this.getTaskById(taskId, workspaceId);
    if (!task || !task.worklogs) return null;

    task.worklogs = task.worklogs.filter((w) => w.id !== worklogId);
    task.loggedHours = Number((task.worklogs.reduce((sum, item) => sum + (Number(item.hours) || 0), 0)).toFixed(2));
    task.updatedAt = new Date().toISOString();

    this.tasks.set(task.id, task);
    return task;
  }

  // --- Document Methods ---

  public getDocuments(workspaceId: string): Document[] {
    return Array.from(this.documents.values()).filter((d) => d.workspaceId === workspaceId);
  }

  public getDocumentById(docId: string, workspaceId: string): Document | null {
    const doc = this.documents.get(docId);
    if (!doc || doc.workspaceId !== workspaceId) return null;
    return doc;
  }

  public createDocument(doc: Document, actor: User): Document {
    this.documents.set(doc.id, doc);
    this.indexWorkspaceDocuments(doc.workspaceId);
    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId: doc.workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'created_document',
      targetType: 'document',
      targetId: doc.id,
      targetName: doc.title,
      details: 'Created new collaborative document',
      createdAt: new Date().toISOString(),
    });
    return doc;
  }

  public updateDocument(doc: Document, actor: User, changeSummary?: string): Document {
    const existing = this.documents.get(doc.id);
    const version = (existing?.version || 1) + 1;
    const updatedDoc: Document = {
      ...doc,
      version,
      lastEditedById: actor.id,
      lastEditedBy: actor,
      updatedAt: new Date().toISOString(),
    };

    const versions = this.documentVersions.get(doc.id) || [];
    versions.push({
      id: `ver_${doc.id}_${version}`,
      version,
      authorId: actor.id,
      authorName: actor.name,
      title: doc.title,
      snapshot: doc.rawText,
      timestamp: new Date().toISOString(),
      changeSummary: changeSummary || 'Real-time collaborative CRDT update',
    });
    this.documentVersions.set(doc.id, versions);

    this.documents.set(doc.id, updatedDoc);
    this.indexWorkspaceDocuments(doc.workspaceId);

    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId: doc.workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'edited_document',
      targetType: 'document',
      targetId: doc.id,
      targetName: doc.title,
      details: changeSummary || `Saved version v${version}`,
      createdAt: new Date().toISOString(),
    });
    return updatedDoc;
  }

  public deleteDocument(docId: string, workspaceId: string, actor: User): boolean {
    const doc = this.getDocumentById(docId, workspaceId);
    if (!doc) return false;
    this.documents.delete(docId);
    this.indexWorkspaceDocuments(workspaceId);
    return true;
  }

  // --- Comment Methods ---

  public getComments(workspaceId: string, targetType?: string, targetId?: string): Comment[] {
    return Array.from(this.comments.values()).filter(
      (c) =>
        c.workspaceId === workspaceId &&
        (!targetType || c.targetType === targetType) &&
        (!targetId || c.targetId === targetId)
    );
  }

  public addComment(comment: Comment, actor: User): Comment {
    this.comments.set(comment.id, comment);

    if (comment.targetType === 'task') {
      const task = this.tasks.get(comment.targetId);
      if (task) {
        task.commentsCount = (task.commentsCount || 0) + 1;
        this.tasks.set(task.id, task);
      }
    }

    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId: comment.workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'added_comment',
      targetType: comment.targetType,
      targetId: comment.targetId,
      targetName: `Comment on ${comment.targetType}`,
      details: comment.content.slice(0, 80) + (comment.content.length > 80 ? '...' : ''),
      createdAt: new Date().toISOString(),
    });
    return comment;
  }

  public resolveComment(commentId: string, workspaceId: string, actor: User, resolved: boolean): Comment | null {
    const c = this.comments.get(commentId);
    if (!c || c.workspaceId !== workspaceId) return null;
    c.resolved = resolved;
    c.resolvedBy = resolved ? actor.name : undefined;
    c.resolvedAt = resolved ? new Date().toISOString() : undefined;
    c.updatedAt = new Date().toISOString();
    this.comments.set(commentId, c);

    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'resolved_comment',
      targetType: c.targetType,
      targetId: c.targetId,
      targetName: `Comment thread on ${c.targetType}`,
      details: resolved ? 'Marked thread as resolved' : 'Reopened comment thread',
      createdAt: new Date().toISOString(),
    });
    return c;
  }

  // --- Files Methods ---

  public getFiles(workspaceId: string): FileItem[] {
    return Array.from(this.files.values()).filter((f) => f.workspaceId === workspaceId);
  }

  public addFile(file: FileItem, actor: User): FileItem {
    this.files.set(file.id, file);
    this.indexWorkspaceDocuments(file.workspaceId);
    this.logActivity({
      id: `act_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      workspaceId: file.workspaceId,
      userId: actor.id,
      userName: actor.name,
      userAvatar: actor.avatar,
      userRole: actor.role,
      action: 'uploaded_file',
      targetType: 'file',
      targetId: file.id,
      targetName: file.name,
      details: `Uploaded ${file.name} (${Math.round(file.size / 1024)} KB) and indexed for RAG`,
      createdAt: new Date().toISOString(),
    });
    return file;
  }

  public deleteFile(fileId: string, workspaceId: string, actor: User): boolean {
    const f = this.files.get(fileId);
    if (!f || f.workspaceId !== workspaceId) return false;
    this.files.delete(fileId);
    this.indexWorkspaceDocuments(workspaceId);
    return true;
  }

  // --- Activity Feed ---

  public getActivities(workspaceId: string, limit = 50): ActivityLog[] {
    const list = this.activities.get(workspaceId) || [];
    return [...list].sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()).slice(0, limit);
  }

  public logActivity(activity: ActivityLog) {
    const list = this.activities.get(activity.workspaceId) || [];
    list.unshift(activity);
    if (list.length > 200) list.pop();
    this.activities.set(activity.workspaceId, list);
  }
}

// Global Singleton for Container Runtime
const globalForDb = global as unknown as { dbStore?: DatabaseStore };
export const db = globalForDb.dbStore || new DatabaseStore();
if (process.env.NODE_ENV !== 'production') globalForDb.dbStore = db;
